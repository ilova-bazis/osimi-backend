COMPOSE_PROJECT_NAME=osimi-archive
IMAGE_TAG=local
APP_BUILD_ID=local

PUBLIC_ORIGIN=https://archive.example.com
PROXY_NETWORK=existing-nginx-proxy
POSTGRES_NETWORK=existing-postgresql

STAGING_HOST_PATH=/srv/osimi-archive/staging
SECRETS_DIR=./secrets
DB_SCHEMA=public

MAX_UPLOAD_SIZE_BYTES=2147483648
MAX_ARTIFACT_SEARCH_TEXT_BYTES=10485760
ARTIFACT_FINALIZATION_INTERVAL_SECONDS=30
ARTIFACT_FINALIZATION_BATCH_SIZE=25
ARTIFACT_FINALIZATION_CLAIM_TIMEOUT_SECONDS=300

API_MEMORY_LIMIT=1g
API_CPUS=1.0
UI_MEMORY_LIMIT=512m
UI_CPUS=0.75
MIGRATION_MEMORY_LIMIT=1g
MIGRATION_CPUS=1.0
LOG_MAX_SIZE=10m
