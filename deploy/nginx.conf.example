# Merge these server blocks into the existing nginx configuration. Replace the
# domain and certificate paths with the certificates already managed on the VPS.
# The nginx container must already be attached to the external PROXY_NETWORK.
server {
    listen 80;
    server_name archive.example.com;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name archive.example.com;

    ssl_certificate /etc/letsencrypt/live/archive.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/archive.example.com/privkey.pem;

    client_max_body_size 2g;

    location /api/ {
        proxy_pass http://osimi-api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://osimi-ui:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
