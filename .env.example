# Database Connections
DATABASE_URL=postgres://postgres:postgres@localhost:5432/osimi
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/osimi_test

# Required Security Configuration (must be at least 32 characters long)
UPLOAD_SIGNING_SECRET=dev_upload_signing_secret_min_32_chars_long_123456
LEASE_SIGNING_SECRET=dev_lease_signing_secret_min_32_chars_long_123456

# Worker Authentication Token
WORKER_AUTH_TOKEN=dev_worker_auth_token_secret_value

# Optional Server & DB Configuration
PORT=3000
HOST=0.0.0.0
DB_SCHEMA=public

# Browser UI origins allowed to call API and direct-upload endpoints.
# Comma-separated exact origins; leave empty to deny all cross-origin callers.
CORS_ALLOWED_ORIGINS=http://localhost:4444,http://localhost:5173

# Maximum materialized OCR/transcript body size read into the search projection (10 MiB).
MAX_ARTIFACT_SEARCH_TEXT_BYTES=10485760

# Verified artifact-upload finalization retry loop.
ARTIFACT_FINALIZATION_INTERVAL_SECONDS=30
ARTIFACT_FINALIZATION_BATCH_SIZE=25
ARTIFACT_FINALIZATION_CLAIM_TIMEOUT_SECONDS=300
